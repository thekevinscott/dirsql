{
  "name": "dirsql",
  "version": "0.0.1",
  "description": "Ephemeral SQL index over a local directory",
  "license": "MIT",
  "repository": "https://github.com/thekevinscott/dirsql",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dirsql": "dist/cli/dirsql.js"
  },
  "files": ["dist/", "docs/", "README.md", "LICENSE"],
  "napi": {
    "binaryName": "dirsql",
    "triples": {}
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "wireit",
    "build:debug": "wireit",
    "stage:platform": "wireit",
    "prepack": "tsx tools/stage-docs.ts pre",
    "postpack": "tsx tools/stage-docs.ts post",
    "test": "wireit",
    "test:unit": "wireit",
    "test:integration": "wireit",
    "test:e2e": "wireit",
    "test:smoke": "wireit",
    "coverage": "wireit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "wireit": {
    "napi:build": {
      "command": "napi build --release --manifest-path napi/Cargo.toml --output-dir .",
      "output": ["dirsql.node", "index.d.ts"]
    },
    "tsc": {
      "command": "tsc -p tsconfig.build.json",
      "files": ["src/**/*.ts", "tsconfig.json", "tsconfig.build.json"],
      "output": ["dist/**"]
    },
    "stage:platform": {
      "command": "tsx tools/stage-platform.ts",
      "dependencies": ["napi:build"],
      "files": [
        "tools/stage-platform.ts",
        "src/platforms.ts",
        "napi/src/**/*.rs",
        "napi/build.rs",
        "napi/Cargo.toml",
        "../rust/src/**/*.rs",
        "../rust/Cargo.toml"
      ],
      "output": ["build/**"]
    },
    "build": {
      "dependencies": ["napi:build", "tsc", "stage:platform"]
    },
    "build:debug": {
      "command": "napi build --manifest-path napi/Cargo.toml --output-dir . && tsc -p tsconfig.build.json",
      "files": [
        "napi/src/**/*.rs",
        "napi/build.rs",
        "napi/Cargo.toml",
        "../rust/src/**/*.rs",
        "src/**/*.ts",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "output": ["dirsql.node", "dist/**", "index.d.ts"]
    },
    "test": {
      "command": "vitest run",
      "dependencies": ["napi:build", "tsc"],
      "files": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "test:unit": {
      "command": "vitest run --dir src",
      "dependencies": ["napi:build"],
      "files": ["src/**/*.ts", "vitest.config.ts"],
      "output": []
    },
    "test:integration": {
      "command": "vitest run --dir tests/integration --passWithNoTests",
      "dependencies": ["napi:build", "tsc"],
      "files": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "tests/integration/**/*.ts",
        "tests/exists.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "test:e2e": {
      "command": "vitest run --dir tests/e2e --passWithNoTests",
      "dependencies": ["build"],
      "files": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "tests/e2e/**/*.ts",
        "vitest.config.ts",
        "../rust/src/**/*.rs",
        "../rust/Cargo.toml"
      ],
      "output": []
    },
    "test:smoke": {
      "command": "vitest run --dir tests/smoke",
      "dependencies": ["build"],
      "files": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "tests/smoke/**/*.ts",
        "tests/exists.ts",
        "vitest.config.ts",
        "../rust/src/**/*.rs",
        "../rust/Cargo.toml"
      ],
      "output": []
    },
    "coverage": {
      "command": "vitest run --coverage",
      "dependencies": ["napi:build"],
      "files": [
        "src/**/*.ts",
        "tools/**/*.ts",
        "tests/integration/**/*.ts",
        "tests/exists.ts",
        "vitest.config.ts"
      ],
      "output": ["coverage/**"]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@napi-rs/cli": "^3.0.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.1.1",
    "sql.js": "^1.14.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.1",
    "wireit": "^0.14.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  }
}
